    "@shikijs/themes": "^4.2.0",
    "@tanstack/react-query": "5.101.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.9",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.17.0",
    "next-themes": "^0.4.6",
    "react": "19.2.7",
    "react-diff-viewer-continued": "^4.2.2",
